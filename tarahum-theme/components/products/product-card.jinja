{# Image aspect ratio: adapt (natural), square (1/1), portrait (3/4) #}
{% set aspect_ratio = card_image_aspect_ratio | default('adapt') %}
{% set aspect_class = '' if aspect_ratio == 'adapt' else ('aspect-square' if aspect_ratio == 'square' else 'aspect-[3/4]') %}

{% set preorder_badge_variant = 'default' %}

{% set selected_product = product.selected_product %}
{% set has_preorder = product.effective_preorder_campaign is not none %}
{% set can_preorder = product.can_be_preordered %}

{% set can_buy = (selected_product.in_stock or can_preorder) %}
{% set is_in_stock_or_preorderable = product.is_infinite or product.quantity > 0 or can_preorder %}
{% set is_out_of_stock = (product.is_infinite == false and product.quantity <= 0) and not can_preorder  %}

{# Tarahum: donation wording toggle (extras group) #}
{% set donation_words = settings.extras_donation_labels_enabled | default(true) %}

<div
  class="group tarahum-panel relative flex h-full flex-col gap-4 p-3 group-data-[grid=list]/grid:grid group-data-[grid=list]/grid:grid-cols-2 group-data-[grid=list]/grid:grid-rows-[1fr_auto] group-data-[grid=list]/grid:gap-4 md:group-data-[grid=list]/grid:grid-cols-[auto_1fr] md:group-data-[grid=list]/grid:grid-rows-[auto_auto]"
  data-product-card="{{ product.id }}"
>
  <a
    href="{{ url_for('product_details', slug=product.slug) }}"
    class="{{ aspect_class }} tarahum-frame relative block w-full overflow-hidden group-data-[grid=list]/grid:col-span-1 group-data-[grid=list]/grid:row-span-1 group-data-[grid=list]/grid:aspect-square md:group-data-[grid=list]/grid:row-span-2 md:group-data-[grid=list]/grid:h-80"
  >
    <img
      {% if product.main_image and product.main_image.image %}
        src="{{ product.main_image.image.medium }}"
      {% elif product.images and product.images|length > 0 %}
        src="{{ image_url(product.images[0].image.full_size, w=400, q=85, f='auto') }}"
      {% else %}
        src="{{ 'images/product-img.svg' | asset_url }}"
      {% endif %}
      alt="{{ product.name }}"
      onerror="this.onerror=null;this.src='{{ 'images/placeholder-image.svg' | asset_url }}';"
      class="{{ 'h-auto' if aspect_ratio == 'adapt' else 'h-full object-cover' }} w-full object-center"
      {% set img_index = index if index is defined else (loop.index0 if loop is defined else 0) %}
      {% if img_index > 3 %}loading="lazy"{% elif img_index == 0 and is_priority | default(false) %}fetchpriority="high"{% endif %}
    />
    {# Badges sit at the TOP-CENTRE, not in a corner. The arch frame clips its
       top corners hard (46%/22% elliptical radius), which was cutting badges
       into things like "ـفى من الضريبة". The apex of the arch is the one spot
       along the top edge with full clearance. #}
    <div class="absolute top-3 inset-x-0 flex flex-row flex-wrap items-center justify-center gap-2 px-6">
      {# Merchant custom badge #}
      {% if product.badge %}
        {% with product=product %}
          {% include 'components/products/merchant-badge.jinja' %}
        {% endwith %}
      {% endif %}
      {# Out of stock badge — only on a normal shop. On a donation store the
         completed seal below says it instead, because this corner badge sits
         under the arch frame's curve and gets clipped ("ير متوفر"). #}
      {% if is_out_of_stock and not donation_words %}
        <span class="badge badge-filled">{{ _("OUT OF STOCK") }}</span>
      {% endif %}
      {# VAT exemption badge #}
      {% if product.is_taxable == false %}
        <span class="badge badge-filled">{{ _("Tax free") }}</span>
      {% endif %}
      {# Bundle offer badge - loaded via client-side JS #}
      <span
        class="bundle-offer-badge hidden"
        data-bundle-offer-product-id="{{ product.id }}"
      ></span>
    </div>
    {% with product_id=product.id, class='absolute bottom-4 ltr:right-4 rtl:left-4' %}
      {% include 'components/products/wishlist-button.jinja' %}
    {% endwith %}

    {# Completed-case seal — centred, clear of the arch curve #}
    {% if is_out_of_stock and donation_words and settings.ngo_seal_enabled | default(true) %}
      {% with product=product, compact=true %}
        {% include 'components/products/completed-seal.jinja' %}
      {% endwith %}
    {% endif %}
  </a>
  <div
    class="flex flex-1 flex-col gap-3 group-data-[grid=list]/grid:col-span-1 group-data-[grid=list]/grid:row-span-1 group-data-[grid=list]/grid:min-w-0 group-data-[grid=list]/grid:self-start"
  >
    <div class="flex flex-col gap-2">
      <h3 class="text-foreground text-sm font-medium">
        <a href="{{ url_for('product_details', slug=product.slug) }}"> {{ product.name }} </a>
      </h3>
      {% if store.settings.products.reviews_enabled %}
        {% if product.rating %}
          <div class="flex items-center gap-2">
            {% set rating = product.rating.average %}
            {% include 'components/rating-stars.jinja' %}
            {% if product.rating.total_count > 0 %}
              <span class="text-muted text-sm">({{ product.rating.total_count }})</span>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
    </div>
    {# Price Section — skipped on donation stores (settings.product_hide_price) #}
    {% if settings.product_hide_price | default(true, true) %}
    {% elif product.formatted_sale_price is not none %}
      {# Product on sale - show sale price, old price crossed out, and discount #}
      <div class="flex flex-col gap-1">
        <p class="text-foreground text-sm font-semibold">
          {% if product.has_options %}{{ _("From") }}{% endif %}
          {{ product.formatted_sale_price }}
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-destructive text-sm line-through"> {{ product.formatted_price }} </span>
          {% if product.discount_percentage and product.discount_percentage > 0 %}
            <span
              class="bg-success/20 text-xs uppercase tracking-wide text-success inline-flex items-center rounded px-2 py-1 font-medium"
            >
              {{ _("Discount") }} {{ product.discount_percentage }}%
            </span>
          {% endif %}
        </div>
      </div>
    {% else %}
      {# Regular price - no sale #}
      <p class="text-foreground text-base font-bold">
        {% if product.has_options %}{{ _("From") }}{% endif %}
        {{ product.formatted_price }}
      </p>
    {% endif %}

    {# Tarahum: the impact rail — collection progress for cases & projects #}
    {% with product=product, size='sm' %}
      {% include 'components/products/donation-progress.jinja' %}
    {% endwith %}
    {# Description - Only visible in list view #}
    {% if product.short_description or product.description %}
      <p
        class="text-muted text-sm hidden group-data-[grid=list]/grid:line-clamp-1 group-data-[grid=list]/grid:[display:-webkit-box] md:group-data-[grid=list]/grid:line-clamp-3"
      >
        {{ product.short_description|striptags|truncate(200) or product.description|striptags|truncate(200) }}
      </p>
    {% endif %}
  </div>
  {# Cart Actions #}
  <div
    class="mt-auto group-data-[grid=list]/grid:col-span-2 group-data-[grid=list]/grid:row-span-1 group-data-[grid=list]/grid:mt-0 md:group-data-[grid=list]/grid:col-span-1 md:group-data-[grid=list]/grid:col-start-2 md:group-data-[grid=list]/grid:self-start"
  >
    {% if has_preorder %}
      <div style="margin-bottom: 8px; text-align: start;">
        {% set preorder_badge_variant = 'product_card' %}
        {% include 'vitrin:products/preorder_badge.jinja' %}
      </div>
    {% endif %}
    {% if is_out_of_stock %}
      {% if donation_words %}
        {# A finished case is finished — it is not "coming back in stock", so
           offering a restock alert would mislead the donor. #}
        <span class="tarahum-done-note w-full md:group-data-[grid=list]/grid:w-1/2">
          {{ _("Completed — thank you") }}
        </span>
      {% else %}
        {# Notify Me Button - shown when out of stock #}
        <button
          class="btn btn-outlined btn-lg w-full md:group-data-[grid=list]/grid:w-1/2 text-wrap"
          data-notify-me-trigger="{{ product.id }}"
        >
          {{ _("Notify me when available") }}
        </button>
      {% endif %}
    {% else %}
      {# Card CTA.

         On a donation store this button must NOT add to the cart: the product
         is priced per riyal, so a click would silently donate 1 SAR without
         ever asking the donor for an amount. Instead it opens the case page,
         where the amount chips live. Set product_card_cta_to_page to false to
         restore the normal add-to-cart behaviour. #}
      {% set has_options = product.has_options or product.has_fields %}
      {% set cta_to_page = settings.product_card_cta_to_page | default(true, true) %}

      {% if cta_to_page and not has_preorder %}
        <a
          class="btn btn-filled btn-lg w-full md:group-data-[grid=list]/grid:w-1/2"
          href="{{ url_for('product_details', slug=product.slug) }}"
        >
          {% if donation_words %}
            {{ _("Donate now") }}
          {% else %}
            {{ _("View product") }}
          {% endif %}
        </a>
      {% else %}
        <button
          class="btn btn-filled btn-lg w-full md:group-data-[grid=list]/grid:w-1/2"
          {% if has_options %}
            data-open-quick-view="true" data-product-id="{{ product.id }}"
          {% else %}
            data-add-to-cart="{{ product.id }}"
          {% endif %}
        >
          {% if has_preorder %}
            {{ _("Preorder now") }}
          {% elif has_options %}
            {{ _("Select options") }}
          {% elif donation_words %}
            {{ _("Donate now") }}
          {% else %}
            {{ _("Add to cart") }}
          {% endif %}
        </button>
      {% endif %}

      {# Quantity Input (hidden, shown after adding to cart) #}
      <div
        class="w-full md:group-data-[grid=list]/grid:w-1/2"
        data-quantity-section
        hidden
      >
        {% with id='card-qty-' ~ product.id, product_id=product.id, quantity=1, show_delete=true, full_width=true %}
          {% include 'components/ui/quantity-input.jinja' %}
        {% endwith %}
      </div>
    {% endif %}
  </div>
</div>

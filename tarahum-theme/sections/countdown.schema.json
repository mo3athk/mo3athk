{
  "template": "sections/countdown.jinja",
  "name": {
    "ar": "العد التنازلي",
    "en": "Countdown Timer"
  },
  "icon": "timer-line",
  "settings": [
    {
      "id": "badge_text",
      "type": "text",
      "label": {
        "ar": "نص الشارة",
        "en": "Badge Text"
      },
      "default": "حملة تنتهي قريبًا ⏳"
    },
    {
      "id": "title",
      "type": "text",
      "label": {
        "ar": "العنوان",
        "en": "Title"
      },
      "default": "باقي على إغلاق الحملة"
    },
    {
      "id": "description",
      "type": "textarea",
      "label": {
        "ar": "الوصف",
        "en": "Description"
      },
      "default": "ساهم قبل انتهاء المدة — كل ريال يفرق."
    },
    {
      "id": "end_date",
      "type": "text",
      "label": {
        "ar": "تاريخ الانتهاء",
        "en": "End Date"
      },
      "info": {
        "ar": "اكتبه بصيغة: 2026-12-31 (سنة-شهر-يوم). لو التاريخ غير صحيح أو فاضي، يظهر القسم كبانر بدون عدّاد.",
        "en": "Format: 2026-12-31 (year-month-day). If the date is invalid or empty, the section shows as a banner without the timer."
      },
      "default": ""
    },
    {
      "id": "button_text",
      "type": "text",
      "label": {
        "ar": "نص الزر",
        "en": "Button Text"
      },
      "default": "تبرّع الآن"
    },
    {
      "id": "button_url",
      "type": "url",
      "label": {
        "ar": "رابط الزر",
        "en": "Button URL"
      },
      "default": ""
    },
    {
      "id": "background_image",
      "type": "image",
      "label": {
        "ar": "صورة الخلفية (سطح المكتب)",
        "en": "Background Image (Desktop)"
      },
      "info": {
        "ar": "ارفع صورة بحجم 1500 × 480 بكسل",
        "en": "Upload image 1500 × 480 px"
      }
    },
    {
      "id": "background_image_mobile",
      "type": "image",
      "label": {
        "ar": "صورة الخلفية (موبايل)",
        "en": "Background Image (Mobile)"
      },
      "info": {
        "ar": "ارفع صورة بحجم 414 × 480 بكسل",
        "en": "Upload image 414 × 480 px"
      }
    },
    {
      "id": "overlay_opacity",
      "type": "range",
      "label": {
        "ar": "شفافية الطبقة",
        "en": "Overlay Opacity"
      },
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 5
    }
  ]
}
